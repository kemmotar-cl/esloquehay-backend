{
  "name": "esloquehay-backend",
  "version": "1.0.0",
  "description": "Backend AI para EsLoQueHay — Cocina y Viajes",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:dev": "wrangler dev src/worker.ts",
    "worker:deploy": "wrangler deploy src/worker.ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.92.0"
  }
}
